# Copy to autonomous-dev/.env and fill in. NEVER commit the .env file.
# Values are loaded into the controller's memory only; they are NOT exported to
# os.environ, so agent sub-processes and test runs do not inherit them.

# --- Claude authentication -------------------------------------------------
# Option 1 (recommended for unattended runs): an Anthropic API key with billing.
# Option 2: leave empty and log in once with the Claude Code CLI ("claude auth login").
#           The SDK's bundled CLI then uses that login (subject to your plan's limits).
ANTHROPIC_API_KEY=

# --- Telegram (create a bot with @BotFather) -------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# Chat that receives notifications (your private chat id or a group id).
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids allowed to issue /pause, /stop, ... commands.
TELEGRAM_AUTHORIZED_USER_IDS=

# --- Controller -------------------------------------------------------------
AUTODEV_LOG_LEVEL=INFO
# Optional override of the SQLite state database location.
AUTODEV_DB_PATH=
